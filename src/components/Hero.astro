---
const personalImageAlt = "Joaquin S. Cárdenas"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
import GitHub from "./icons/GitHub.astro"

// TODO: Preparar para i18n en siguiente fase
const hero = {
  name: "Joaquin S. Cárdenas",
  title: "Financial BI & Data Strategist",
  badge: "ex-KPMG #1 Training | SSN Holder",
}
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/Foto_Prueba.webp"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/joaquin-cardenas/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{hero.badge}</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {hero.name}
  </h1>
  <h2 class="text-2xl font-semibold text-yellow-500 dark:text-yellow-300 mt-2">
    {hero.title}
  </h2>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
      Former <strong>KPMG analyst</strong> (#1 Training Excellence), especializado en convertir datos en <strong>inteligencia de negocios medible</strong>. 
      Mi enfoque es <strong>datificar procesos financieros complejos</strong> mediante ETL automation, Python, SQL y dashboards interactivos. 
      Experiencia comprobada: <strong>+55% revenue growth</strong> en Toro Loco Bar & Grill mediante optimización de operaciones y BI strategy.
      <strong>Stack:</strong> Python (Pandas/Polars/uv) • SQL (PostgreSQL) • Power BI • Linux (Fedora)
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:joaquin.data.dev@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/joaquin-cardenas/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/DaelFame">
      <GitHub class="size-4"/>
      GitHub
    </SocialPill>
      
  </nav>
</div>
