---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "Actualmente..",
    title: "Analista autodidacta en automatización contable y datos",
    company: "Proyecto personal independiente",
    description:
      "Desarrollé soluciones automatizadas para control de costos y análisis financiero aplicando herramientas como Excel avanzado, Power BI y Manager.io. Investigué de forma autodidacta tecnologías aplicadas a fintechs, automatización y ciencia de datos, enfocándome en optimizar procesos contables y prepararme para entornos digitales.",
    link: "github.com/joaquin-cardenas",
  },
  {
    date: "Enero 2023 - Junio 2023",
    title: "Asistente contable y administrativo con enfoque en digitalizacion de procesos",
    company: "Talleres Escarcina Torres",
    description:
      "Apoyé en la elaboración de reportes financieros, conciliaciones bancarias, control de gastos e ingresos. Propuse mejoras para procesos internos y contribuí a una mejor planificación del flujo de efectivo en coordinación con el área de finanzas.",
  },
  {
    date: "Febrero 2020 - Junio 2022",
    title: "Administrador General",
    company: "Toro Loco Bar & Grill",
    description:
      "Lideré procesos administrativos, gestión de inventario, control financiero y coordinación de personal. Esta experiencia fortaleció mis habilidades en liderazgo, planificación, uso de herramientas de oficina y resolución de problemas con enfoque práctico y adaptable",
  },
  {
    date: "Diciembre 2021 - Marzo 2022",
    title: "Colaborador operativo en entorno internacional (USA)",
    company: "Westin Hotel & Resort, Honolulu, EE.UU",
    description:
      "Participé en un entorno profesional internacional donde desarrollé habilidades en comunicación en inglés, trabajo en equipo y gestión del tiempo. Esta experiencia refuerza mi preparación para colaborar en equipos globales y entornos remotos.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
