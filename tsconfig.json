{
  "compilerOptions": {
    "jsxImportSource": "astro",
    "allowJs": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "module": "esnext",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}